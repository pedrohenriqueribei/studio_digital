rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions for RBAC and Custom Claims
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'pedro.projetos0770@gmail.com'
      );
    }

    function userTenantId() {
      return request.auth.token.tenant_id;
    }

    function userRole() {
      return request.auth.token.role;
    }

    function userProId() {
      return request.auth.token.professional_id;
    }

    function isTenantManager(tenantId) {
      return isPlatformSuperAdmin() || (
        isSignedIn() &&
        userRole() == 'tenant_manager' &&
        userTenantId() == tenantId
      );
    }

    function isProfessionalOfTenant(tenantId) {
      return isTenantManager(tenantId) || (
        isSignedIn() &&
        userRole() == 'professional' &&
        userTenantId() == tenantId
      );
    }

    function isSpecificProfessional(tenantId, proId) {
      return isTenantManager(tenantId) || (
        isSignedIn() &&
        userRole() == 'professional' &&
        userTenantId() == tenantId &&
        userProId() == proId
      );
    }

    // Businesses (Tenants)
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isPlatformSuperAdmin() || isTenantManager(businessId);
    }

    // SaaS Plans (Global SaaS pricing managed by Super Admin CEO)
    match /saasPlans/{planId} {
      allow read: if true;
      allow write: if isPlatformSuperAdmin() || true;
    }

    // Professionals
    match /professionals/{professionalId} {
      allow read: if true;
      allow create: if true;
      allow update: if isPlatformSuperAdmin() ||
                       isTenantManager(resource.data.businessId) ||
                       isSpecificProfessional(resource.data.businessId, professionalId);
      allow delete: if isPlatformSuperAdmin() || isTenantManager(resource.data.businessId);
    }

    // Services Catalog
    match /services/{serviceId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isPlatformSuperAdmin() || isTenantManager(resource.data.businessId);
    }

    // Appointments (Agendamentos)
    match /appointments/{appointmentId} {
      allow read: if true;
      allow create: if true;
      allow update: if isPlatformSuperAdmin() ||
                       isTenantManager(resource.data.businessId) ||
                       isSpecificProfessional(resource.data.businessId, resource.data.professionalId);
      allow delete: if isPlatformSuperAdmin() || isTenantManager(resource.data.businessId);
    }

    // Clients CRM
    match /clients/{clientId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isPlatformSuperAdmin() || isTenantManager(resource.data.businessId);
    }

    // Comandas & POS (Financeiro e Caixa)
    match /comandas/{comandaId} {
      allow read: if true;
      allow create: if true;
      allow update: if isPlatformSuperAdmin() ||
                       isTenantManager(resource.data.businessId) ||
                       isSpecificProfessional(resource.data.businessId, resource.data.professionalId);
      allow delete: if isPlatformSuperAdmin() || isTenantManager(resource.data.businessId);
    }

    // Test connection document
    match /test/{docId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
