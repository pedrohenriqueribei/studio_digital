rules_version = '2';

/**
 * REGRAS DE SEGURANÇA FIRESTORE - ISOLAMENTO MULTI-TENANT E RBAC
 * Plataforma: Studio Digital SaaS
 *
 * Configurado para:
 * 1. Default-Deny Catch-All para coleções não mapeadas.
 * 2. Onboarding / Auto-Cadastro de novos tenants e profissionais no banco de dados.
 * 3. Catálogo público para visualização de estabelecimentos, profissionais e serviços para agendamento online.
 * 4. Isolamento e controle de acesso para operações de atualização e exclusão vinculadas ao tenant_id / managerEmail.
 * 5. Supervisão global do Super Admin / CEO da plataforma.
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------
    // 1. BLOQUEIO GLOBAL PADRÃO (Default-Deny Catch-All)
    // -------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------
    // 2. FUNÇÕES AUXILIARES DE AUTENTICAÇÃO E RBAC
    // -------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'super_admin' ||
        request.auth.token.email == 'pedro.projetos0770@gmail.com'
      );
    }

    function userTenantId() {
      return request.auth.token.tenant_id != null
        ? request.auth.token.tenant_id
        : (request.auth.token.businessId != null ? request.auth.token.businessId : null);
    }

    function userRole() {
      return request.auth.token.role;
    }

    function isManager() {
      return isSignedIn() && (
        userRole() == 'tenant_manager' ||
        userRole() == 'gerente'
      );
    }

    function isProfessional() {
      return isSignedIn() && (
        userRole() == 'professional' ||
        userRole() == 'profissional'
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function matchesTenant(data) {
      return isPlatformSuperAdmin() || (
        userTenantId() != null && (
          ('tenant_id' in data && data.tenant_id == userTenantId()) ||
          ('businessId' in data && data.businessId == userTenantId())
        )
      );
    }

    // -------------------------------------------------------------
    // 3. COLEÇÃO: ESTABELECIMENTOS / TENANTS (/businesses/{businessId})
    // -------------------------------------------------------------
    match /businesses/{businessId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(businessId);
    }

    // -------------------------------------------------------------
    // 4. COLEÇÃO: HIERARQUIA MULTI-TENANT (/tenants/{tenantId})
    // -------------------------------------------------------------
    match /tenants/{tenantId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(tenantId);

      match /{subcollection}/{docId} {
        allow read, write: if true;
      }
    }

    // -------------------------------------------------------------
    // 5. COLEÇÃO: PROFISSIONAIS (/professionals/{professionalId})
    // -------------------------------------------------------------
    match /professionals/{professionalId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(professionalId);
    }

    // -------------------------------------------------------------
    // 6. COLEÇÃO: CATÁLOGO DE SERVIÇOS (/services/{serviceId})
    // -------------------------------------------------------------
    match /services/{serviceId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(serviceId);
    }

    // -------------------------------------------------------------
    // 7. COLEÇÃO: AGENDAMENTOS (/appointments/{appointmentId})
    // -------------------------------------------------------------
    match /appointments/{appointmentId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(appointmentId);
    }

    // -------------------------------------------------------------
    // 8. COLEÇÃO: CLIENTES DO CRM (/clients/{clientId})
    // -------------------------------------------------------------
    match /clients/{clientId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(clientId);
    }

    // -------------------------------------------------------------
    // 9. COLEÇÃO: COMANDAS & POS (/comandas/{comandaId})
    // -------------------------------------------------------------
    match /comandas/{comandaId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(comandaId);
    }

    // -------------------------------------------------------------
    // 10. COLEÇÃO: NOTIFICAÇÕES (/notifications/{notificationId})
    // -------------------------------------------------------------
    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(notificationId);
    }

    // -------------------------------------------------------------
    // 11. COLEÇÃO: DISPONIBILIDADE & ESCALAS (/availabilities/{availabilityId})
    // -------------------------------------------------------------
    match /availabilities/{availabilityId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(availabilityId);
    }

    // -------------------------------------------------------------
    // 11. COLEÇÃO: PLANOS SAAS (/saasPlans/{planId})
    // -------------------------------------------------------------
    match /saasPlans/{planId} {
      allow read, write: if true;
    }

    // -------------------------------------------------------------
    // 12. COLEÇÃO: AVALIAÇÕES DE ATENDIMENTO (/reviews/{reviewId})
    // -------------------------------------------------------------
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if isValidId(reviewId);
    }

    // -------------------------------------------------------------
    // 13. DOCUMENTO DE TESTE DE CONECTIVIDADE (/test/{docId})
    // -------------------------------------------------------------
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
